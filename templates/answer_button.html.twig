{% if with_modal %}
    {% set modal_html %}{{ include('@wikitsemantics/answer_modal.html.twig') }}{% endset %}
    <script>
        if (typeof window.wikitSemanticsModalHTML === 'undefined') {
            window.wikitSemanticsModalHTML = {{ modal_html|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT') b-or constant('JSON_HEX_AMP'))|raw }};
        }
    </script>
{% endif %}
<div id="wikitsemantics-button-{{ item_type }}-{{ ticket_id }}"
     class="wikitsemantics-button-container"
     data-ticket-id="{{ ticket_id }}"
     data-item-type="{{ item_type }}"
     data-container-selector="{{ container_selector }}"
     data-button-label="{{ button_label }}"
     data-streaming-enabled="{{ streaming_enabled }}"
     data-plugin-path="{{ plugin_path }}"
     data-ajax-url="{{ plugin_path }}/ajax/generateanswer.php"
     data-ajax-stream-url="{{ plugin_path }}/ajax/generateanswer_stream.php"
     data-label-add="{{ __('Add to ticket', 'wikitsemantics') }}"
     data-label-close="{{ __('Close', 'wikitsemantics') }}"
     data-label-error="{{ __('GLPI encountered a problem connecting to the Wikit Semantics application. Please try again later.', 'wikitsemantics') }}"
     data-label-no-sources="{{ __('No sources available for this answer.', 'wikitsemantics') }}">
</div>
