{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% set params = params|merge({'candel': false}) %}

{% block form_fields %}
    {{ fields.smallTitle(__('Common settings', 'wikitsemantics'), 'ti ti-settings') }}
    {{ fields.textField('url_api', item.fields['url_api']|default('https://apis.wikit.ai'), __('Wikit Semantics URL base', 'wikitsemantics'), {
        full_width: true,
    }) }}
    {{ fields.textField('organization_id', item.fields['organization_id'], __('Organization ID', 'wikitsemantics'), {
        full_width: true,
    }) }}
    {{ fields.textField('api_key', api_key_display, __('API key', 'wikitsemantics'), {
        full_width: true,
        additional_attributes: {
            placeholder: __('Enter new API key to change', 'wikitsemantics'),
            autocomplete: 'off',
        },
    }) }}
    {{ fields.sliderField('is_streaming_enabled', item.fields['is_streaming_enabled'], __('Enable Streaming Mode', 'wikitsemantics'), {
        label2: __('Stream responses token by token', 'wikitsemantics'),
        full_width: true,
    }) }}

    {{ fields.smallTitle(__('Ticket answer suggestion', 'wikitsemantics'), 'ti ti-message-chatbot') }}
    {{ fields.textField('app_id_answer', item.fields['app_id_answer'], __('Application ID (Answer)', 'wikitsemantics'), {
        full_width: true,
    }) }}

    {{ fields.smallTitle(__('Knowledge base generation', 'wikitsemantics'), 'ti ti-book') }}
    {{ fields.sliderField('is_kb_enabled', item.fields['is_kb_enabled'], __('Enable Knowledge Base generation', 'wikitsemantics'), {
        full_width: true,
    }) }}
    {{ fields.textField('app_id_kb', item.fields['app_id_kb'], __('Application ID (Knowledge Base)', 'wikitsemantics'), {
        full_width: true,
    }) }}

    {{ fields.smallTitle(__('Editor AI assistant', 'wikitsemantics'), 'ti ti-wand') }}
    {{ fields.sliderField('is_editor_ai_enabled', item.fields['is_editor_ai_enabled'], __('Enable Editor AI assistant', 'wikitsemantics'), {
        label2: [__('Correction', 'wikitsemantics'), __('Formatting', 'wikitsemantics'), __('Translation', 'wikitsemantics')]|join(' · '),
        full_width: true,
    }) }}
    {{ fields.textField('app_id_editor', item.fields['app_id_editor'], __('Application ID (Editor AI)', 'wikitsemantics'), {
        full_width: true,
    }) }}

    {% if item.fields['url_api'] is not empty %}
        <div class="col-12 mt-3 text-center">
            <button class="btn btn-outline-secondary" type="submit" name="TestConnection" value="1">
                <i class="ti ti-plug-connected me-1"></i>
                {{ __('Test connection', 'wikitsemantics') }}
            </button>
        </div>
    {% endif %}
{% endblock %}
